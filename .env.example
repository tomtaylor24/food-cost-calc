JWT_SECRET=

# MySQL への接続先。docker compose up -d で起動したローカルDBなら下の値をそのまま使える
# mysql://ユーザー名:パスワード@ホスト:ポート/データベース名
DATABASE_URL=mysql://genkalc:genkalcpass@127.0.0.1:3307/genkalc

# 以下は任意。未設定でもアプリは動く（パスワード再設定メールがターミナルに出力される）
# APP_URL はリセットURLの組み立てに使う。未設定なら http://localhost:3000
APP_URL=
# BREVO_API_KEY と MAIL_FROM の両方が揃うと、実際にメールを送るようになる
BREVO_API_KEY=
# Brevo で確認済みの送信元アドレス
MAIL_FROM=
# 差出人の表示名。未設定なら Genkalc
MAIL_FROM_NAME=
